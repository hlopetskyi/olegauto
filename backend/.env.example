# Database (отримаєте після створення проекту на Railway)
DATABASE_URL=postgres://user:password@host:5432/railway

# Redis (опціонально, але рекомендовано для продакшну)
REDIS_URL=redis://localhost:6379

# Секретні ключі (замініть на будь-який довгий рядок)
JWT_SECRET=your-super-secret-jwt-key-change-this
COOKIE_SECRET=your-super-secret-cookie-key-change-this

# URLs
BACKEND_URL=https://your-railway-app.up.railway.app
STORE_CORS=https://your-vercel-app.vercel.app
ADMIN_CORS=https://your-railway-app.up.railway.app
AUTH_CORS=https://your-railway-app.up.railway.app,https://your-vercel-app.vercel.app

# Перший адмін користувач (для seed скрипту)
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=your-admin-password
